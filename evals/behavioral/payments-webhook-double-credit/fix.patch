diff --git a/repo/credit_book.py b/repo/credit_book.py
index ba35214..916756a 100644
--- a/repo/credit_book.py
+++ b/repo/credit_book.py
@@ -4,15 +4,36 @@ The handler talks to this and never to the service client directly, so anything
 true of every credit belongs in here.
 """

+import threading
+

 class CreditBook:
     def __init__(self, service):
         self.service = service
+        self._lock = threading.Lock()
+        self._applied_effects = set()

     def credit(self, customer_id, amount_minor, memo):
         if amount_minor <= 0:
             raise ValueError("a credit must be positive")
         return self.service.apply_credit(customer_id, amount_minor, memo)

+    def credit_once(self, effect_key, customer_id, amount_minor, memo):
+        """Apply one credit for one refund transition, whichever delivery reported it.
+
+        effect_key names the refund and the transition it made, not the event object that
+        carried the news, so a second event describing the same refund settling finds the effect
+        already applied and moves no money. The check, the write and the record of the write are
+        taken together under one lock: a delivery that arrives while another is still inside the
+        service round trip waits, and then sees the effect already applied rather than adding a
+        second credit that both of them believed was the first.
+        """
+        with self._lock:
+            if effect_key in self._applied_effects:
+                return self.balance(customer_id)
+            balance = self.credit(customer_id, amount_minor, memo)
+            self._applied_effects.add(effect_key)
+            return balance
+
     def balance(self, customer_id):
         return self.service.balance(customer_id)
