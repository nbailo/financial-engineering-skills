@@ -13,5 +14,16 @@ class CreditBook:
         self.journal.append({"customer_id": customer_id, "amount": amount_minor, "memo": memo})
         return self.balances[customer_id]
 
+    def credit_refund(self, refund_id, customer_id, amount_minor):
+        """One settled refund is one credit, whichever event type reported it.
+
+        The applied refund id is recorded with the credit, so a second event describing the
+        same refund settling finds it already applied and moves no money.
+        """
+        if refund_id in self.credited_refunds:
+            return self.balance(customer_id)
+        self.credited_refunds.add(refund_id)
+        return self.credit(customer_id, amount_minor, "refund " + refund_id)
+
     def balance(self, customer_id):
         return self.balances.get(customer_id, 0)
