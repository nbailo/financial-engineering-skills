diff --git a/repo/credit_service.py b/repo/credit_service.py
index bd45602..1641dae 100644
--- a/repo/credit_service.py
+++ b/repo/credit_service.py
@@ -5,16 +5,25 @@ refund event. The webhook endpoint runs several delivery workers, so two deliver
 same refund are routinely inside that round trip at the same moment; whatever guards the credit
 has to still hold while one worker is parked in here.

+This service is the one thing every delivery worker shares, so it is also the only place a claim
+on a refund transition means anything. apply_credit_once takes the claim and the write together
+under this service's own lock: a worker that arrives while another is still in the round trip
+waits for it, and then finds the effect already applied instead of writing a second credit.
+
 before_write is where the round trip is spent. Integration tests hang a stand-in on it so that
 overlap is reproducible without a network.
 """

+import threading
+

 class StoreCreditService:
     def __init__(self):
         self._balances = {}
         self.writes = []
         self.before_write = None
+        self._lock = threading.Lock()
+        self._applied_effects = set()

     def apply_credit(self, customer_id, amount_minor, memo):
         """Move amount_minor of store credit onto the customer. One call, one write."""
@@ -26,5 +35,22 @@ class StoreCreditService:
         )
         return self._balances[customer_id]

+    def apply_credit_once(self, effect_key, customer_id, amount_minor, memo):
+        """Apply the credit for one refund transition, whichever delivery reported it.
+
+        effect_key names the refund and the transition it made, not the provider event object
+        that carried the news, so a second event describing the same refund settling finds the
+        effect already applied and moves no money. The check, the write and the record of the
+        write happen as one step under the lock, and the lock is still held while the round trip
+        in apply_credit is in flight, so a worker that gets there during the round trip cannot
+        conclude the credit is still owed.
+        """
+        with self._lock:
+            if effect_key in self._applied_effects:
+                return self._balances.get(customer_id, 0)
+            balance = self.apply_credit(customer_id, amount_minor, memo)
+            self._applied_effects.add(effect_key)
+            return balance
+
     def balance(self, customer_id):
         return self._balances.get(customer_id, 0)
