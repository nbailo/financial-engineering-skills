     def __init__(self):
         self.balances = {}
         self.journal = []
+        self.applied_effects = set()
 
     def credit(self, customer_id, amount_minor, memo):
         if amount_minor <= 0:
@@ -13,5 +14,17 @@ class CreditBook:
         self.journal.append({"customer_id": customer_id, "amount": amount_minor, "memo": memo})
         return self.balances[customer_id]
 
+    def credit_once(self, effect_key, customer_id, amount_minor, memo):
+        """Apply one credit for one object transition, whichever event reported it.
+
+        effect_key names the refund and the transition it made, not the delivery that carried
+        the news, so a second event object describing the same refund settling finds the effect
+        already applied and moves no money.
+        """
+        if effect_key in self.applied_effects:
+            return self.balance(customer_id)
+        self.applied_effects.add(effect_key)
+        return self.credit(customer_id, amount_minor, memo)
+
     def balance(self, customer_id):
         return self.balances.get(customer_id, 0)
