+def _group(rows):
+    """Every row that carries a transfer id, kept.
+
+    The transfer id is the processor's key and neither side promises it appears
+    once: our writer can land an outcome twice and the processor re-cuts batches.
+    Folding either side into one row per id would silently discard the very row
+    that says so, so the rows stay in a list per id and the length is evidence.
+    """
+    grouped = {}
+    for row in rows:
+        grouped.setdefault(row["transfer_id"], []).append(row)
+    return grouped
+
+
+def _total(rows):
