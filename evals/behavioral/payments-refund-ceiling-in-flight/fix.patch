+import threading
+import weakref
+

 class RefundCeilingError(Exception):
     """The refund would return more than this payment can give back."""


+# Per-payment locks live here, keyed by the processor client they guard, and not on any one
+# RefundService. The panel and the webhook endpoint each build their own RefundService over the
+# same client, so a lock held on the instance is a lock two callers on one order never share:
+# both would read the same remainder, both would size their refund against it, and both would
+# send. What has to be serialised is the read-then-reserve against the SHARED state, so the lock
+# has to be keyed to that shared state. The registry is weak in the client so a client that goes
+# out of scope takes its locks with it; the inner dict holds one lock per payment, so two agents
+# on one order queue up while two different orders still refund in parallel.
+_PAYMENT_LOCKS = weakref.WeakKeyDictionary()
+_REGISTRY_GUARD = threading.Lock()
+
+
+def _payment_lock(psp, psp_reference):
+    """The one lock every RefundService over `psp` uses for `psp_reference`."""
+    with _REGISTRY_GUARD:
+        locks = _PAYMENT_LOCKS.get(psp)
+        if locks is None:
+            locks = {}
+            _PAYMENT_LOCKS[psp] = locks
+        lock = locks.get(psp_reference)
+        if lock is None:
+            lock = threading.Lock()
+            locks[psp_reference] = lock
+        return lock
+
