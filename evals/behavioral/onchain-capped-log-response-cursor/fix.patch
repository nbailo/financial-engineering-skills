@@ -6,11 +6,16 @@ CONFIRMATIONS are left for a later pass.
 """

 from chain import ACCOUNT_BY_DEPOSIT_ADDRESS, INTERNAL_ADDRESSES, TRACKED_TOKEN
+from node import MAX_LOGS_PER_RESPONSE

 CONFIRMATIONS = 12
 RANGE_SPAN = 50


+class CoverageError(Exception):
+    """One block holds more logs than a single response can carry."""
+
+
 class DepositStore:
     """Customer balances in base units, the watermark, and what has been applied."""

@@ -40,12 +45,26 @@ def is_deposit(log):


 def sync(node, store):
-    """Credit every deposit between the watermark and the confirmed head."""
+    """Credit every deposit between the watermark and the confirmed head.
+
+    A response the provider filled to its cap carries part of the range and hides the
+    rest, so it credits nothing and the watermark stays where it is. The range narrows
+    and the same blocks are asked for again. Only a response the provider did not have to
+    cap proves the range was covered, and the watermark moves inside that proof. A single
+    block that still fills the cap cannot be covered at all, and that stops the pass
+    rather than skipping the block.
+    """
     safe_head = node.block_number() - CONFIRMATIONS
+    span = RANGE_SPAN
     while store.cursor < safe_head:
         from_block = store.cursor + 1
-        to_block = min(from_block + RANGE_SPAN - 1, safe_head)
+        to_block = min(from_block + span - 1, safe_head)
         logs = node.get_logs(from_block, to_block)
+        if len(logs) >= MAX_LOGS_PER_RESPONSE:
+            if from_block == to_block:
+                raise CoverageError(from_block)
+            span = max(1, span // 2)
+            continue
         for log in logs:
             if is_deposit(log):
                 store.credit(log, ACCOUNT_BY_DEPOSIT_ADDRESS[log["to"]])
